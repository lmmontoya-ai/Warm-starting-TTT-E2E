# Copy to .env and fill in only what you use. Never commit .env.

# Experiment tracking (optional).
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=

# Hugging Face access (optional): only for uploading or restoring stages in
# your own repo with scripts/40_export_stage.py, 46_restore_stage.py or the
# --export-to-hf option of scripts/96_run_revision_v3_ladder.py.
HF_TOKEN=
HF_125M_RESULTS_REPO=

# Google Cloud project billed for reads from the TTT-E2E authors' Requester
# Pays dataset buckets (scripts/00_data_fetch.py).
GCS_BILLING_PROJECT=

# Your own S3-compatible copy of the data (optional, scripts/28_fetch_s3_dataset.py).
# Credentials come from the usual AWS variables or profile.
DATA_BUCKET=
DATA_PREFIX=
S3_ENDPOINT_URL=
